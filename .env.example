# 이 파일을 .env로 복사해 값을 채운다. .env와 실제 키는 레포에 올리지 않는다.
# 키는 로컬 .env, Render 환경변수, Codex 환경 비밀값에 둔다. 발급 경로: .work/design/api-choice.md '설정 경로'

# LLM: Google Gemini API(gemini-3.8-flash). Google AI Studio에서 만든 API 키.
# GOOGLE_API_KEY는 함께 두지 않는다(둘 다 있으면 GOOGLE_API_KEY가 앞선다).
GEMINI_API_KEY=

# Google Calendar: Google Cloud 콘솔에서 만든 OAuth 웹 애플리케이션 클라이언트의 ID와 비밀번호.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 공공데이터포털 인증키: 특일 정보(천문연)·단기예보(기상청)에 함께 쓴다.
DATA_GO_KR_SERVICE_KEY=

# NAVER API HUB 지역 검색: 네이버 클라우드 콘솔 API HUB Application의 인증 정보.
NAVER_HUB_CLIENT_ID=
NAVER_HUB_CLIENT_SECRET=

# 네이버 클라우드 Maps 길찾기(Directions 5): Maps Application의 인증 정보.
NCP_MAPS_CLIENT_ID=
NCP_MAPS_CLIENT_SECRET=
