# 이 파일을 .env로 복사해 값을 채운다. .env와 실제 키는 레포에 올리지 않는다.
# Google 비밀값은 로컬 .env와 Render에 둔다. 공용 서버 OpenAI 키는 개인 설정에서 등록한다.
# 환경변수 이름·뜻의 기준: docs/CONTRACT.md 11절. 모든 값은 비워 둔다.

# LLM: OpenAI Responses API. 메일 분석·답장·기억 요약·성찰·무역 문서 추출에 공통으로 사용.
# 실행 위치: 비우면 server. local은 uv run python -m app.local로만 실행한다(루프백 전용).
# Render·공용 실행에서는 local을 지정하지 않는다.
AI_RUNTIME=
# 본인 /settings에서 로그인으로 검증한 Google 식별자를 확인해 직접 지정한다.
# 개인 PC 실행기 app.worker.pc도 같은 소유자와 개인 .env 키만 읽는다(README 참조).
# 최초 방문자를 자동 등록하지 않는다. 식별자를 채팅·Issue·PR에 올리지 않는다.
LOCAL_OWNER_GOOGLE_SUB=
# local 모드 또는 개인 PC 실행기에서 위 소유자만 사용하는 개인 키. DB에 저장하지 않는다.
# server에서는 이 값을 읽지 않으며 각 사용자가 /settings에 키를 등록한다. 공용 키 대체는 없다.
OPENAI_API_KEY=
# 쓸 OpenAI 모델 이름. 비우면 gpt-6-luna.
OPENAI_MODEL=

# Google OAuth: Gmail과 도구 2(구글캘린더 등록)용 웹 애플리케이션 클라이언트 ID.
# local은 본인 Google Cloud 프로젝트의 개인 클라이언트를 만든다(README 로컬 Gmail 절).
GOOGLE_OAUTH_CLIENT_ID=
# Google OAuth 클라이언트 비밀번호.
GOOGLE_OAUTH_CLIENT_SECRET=
# Google OAuth 리디렉션 주소. 로컬·Render 각각 콘솔에 등록한 콜백 주소와 맞춘다.
GOOGLE_OAUTH_REDIRECT_URI=

# server의 Gmail 감시 등록에 쓰는 Cloud Pub/Sub 토픽 전체 이름. local은 비워도 된다.
# 로컬 수집은 history 조회만 하며 공용 토픽·구독·watch/stop을 바꾸지 않는다.
GMAIL_PUBSUB_TOPIC=
# Pub/Sub 푸시 OIDC 토큰의 대상(audience). 추천하는 OIDC 확인 방식에서 쓴다.
PUBSUB_PUSH_AUDIENCE=
# Pub/Sub 푸시 OIDC 토큰의 서비스 계정 이메일. 추천하는 OIDC 확인 방식에서 쓴다.
PUBSUB_PUSH_SERVICE_ACCOUNT=
# Pub/Sub 대체 인증 방식의 비밀 토큰. 대체 방식을 쓸 때만 설정한다.
PUBSUB_PUSH_TOKEN=

# Postgres 접속 주소. 로컬에서 비우면 SQLite 파일을 쓴다.
DATABASE_URL=
# Google 토큰과 사용자별 OpenAI 키를 암호화하는 Fernet 키. 만들기: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 바꾸면 Google 재로그인과 OpenAI 키 재등록이 필요하다.
TOKEN_ENCRYPTION_KEY=
# 로그인 세션 쿠키를 서명하는 키. 만들기: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# 비우면 서버가 뜰 때마다 임시 키를 써서 재시작하면 로그인이 풀리고, 로그인 버튼도 꺼진다.
SESSION_SECRET=
# 서비스 주소. 링크 생성과 리디렉션 확인에 쓴다.
APP_BASE_URL=

# 성찰 기능의 기본값. 로컬·Render 설정 시 true 또는 false로 지정한다.
REFLECTION_ENABLED_DEFAULT=

# React 개발/운영 화면의 허용 출처. 여러 개면 쉼표로 구분하고 경로는 제외한다.
FRONTEND_ORIGINS=
# 기본 lax. 서로 다른 사이트에서 쿠키를 공유하려면 none과 HTTPS를 함께 설정한다.
SESSION_SAME_SITE=
