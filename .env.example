# 이 파일을 .env로 복사해 값을 채운다. .env와 실제 키는 레포에 올리지 않는다.
# 키는 로컬 .env와 Render 환경변수에 둔다. Codex 환경에는 키를 넣지 않는다. 발급 경로: .work/design/api-choice.md '설정 경로'
# 환경변수 이름·뜻의 기준: docs/CONTRACT.md 11절. 모든 값은 비워 둔다.

# LLM: Google Gemini API(기본 모델 gemini-3.6-flash). Google AI Studio에서 만든 API 키.
# GOOGLE_API_KEY는 함께 두지 않는다(둘 다 있으면 GOOGLE_API_KEY가 앞선다).
GEMINI_API_KEY=
# 쓸 Gemini 모델 이름. 비우면 gemini-3.6-flash. 그 모델이 503 등으로 막힐 때만 다른 무료 모델로 바꾼다.
GEMINI_MODEL=

# Google OAuth: Gmail과 도구 2(구글캘린더 등록)용 웹 애플리케이션 클라이언트 ID.
GOOGLE_OAUTH_CLIENT_ID=
# Google OAuth 클라이언트 비밀번호.
GOOGLE_OAUTH_CLIENT_SECRET=
# Google OAuth 리디렉션 주소. 로컬·Render 각각 콘솔에 등록한 콜백 주소와 맞춘다.
GOOGLE_OAUTH_REDIRECT_URI=

# Gmail 감시 등록에 쓰는 Cloud Pub/Sub 토픽 전체 이름.
GMAIL_PUBSUB_TOPIC=
# Pub/Sub 푸시 OIDC 토큰의 대상(audience). 추천하는 OIDC 확인 방식에서 쓴다.
PUBSUB_PUSH_AUDIENCE=
# Pub/Sub 푸시 OIDC 토큰의 서비스 계정 이메일. 추천하는 OIDC 확인 방식에서 쓴다.
PUBSUB_PUSH_SERVICE_ACCOUNT=
# Pub/Sub 대체 인증 방식의 비밀 토큰. 대체 방식을 쓸 때만 설정한다.
PUBSUB_PUSH_TOKEN=

# Postgres 접속 주소. 로컬에서 비우면 SQLite 파일을 쓴다.
DATABASE_URL=
# 사용자별 Google 토큰을 암호화하는 Fernet 키. 만들기: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 바꾸면 저장된 토큰을 읽지 못해 모든 사용자가 다시 로그인해야 한다.
TOKEN_ENCRYPTION_KEY=
# 로그인 세션 쿠키를 서명하는 키. 만들기: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# 비우면 서버가 뜰 때마다 임시 키를 써서 재시작하면 로그인이 풀리고, 로그인 버튼도 꺼진다.
SESSION_SECRET=
# 서비스 주소. 링크 생성과 리디렉션 확인에 쓴다.
APP_BASE_URL=

# 성찰 기능의 기본값. 로컬·Render 설정 시 true 또는 false로 지정한다.
REFLECTION_ENABLED_DEFAULT=
